# Copy to .env for local runs. .env is gitignored.
# In production these live in GitHub, Vercel and Hugging Face secret settings, never in code.

# GitHub API: Events API and repo metadata (needed from Stage 1)
GITHUB_TOKEN=

# Hugging Face dataset that holds the Parquet lake (needed from Stage 1)
HF_TOKEN=
HF_DATASET_REPO=

# Local working folder for the lake; raw downloads are deleted after each run
LAKE_LOCAL_DIR=data/lake

# Score formula version stamped on every score row (config/score_<version>.toml)
SCORE_FORMULA_VERSION=v1

# Alert destination for failed jobs (needed from Stage 3)
ALERT_WEBHOOK_URL=

# Neo4j AuraDB Free (needed from Stage 4)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Neon Postgres with pgvector (needed from Stage 5)
NEON_DATABASE_URL=

# fastembed model; must produce the embedding size stored in pgvector (needed from Stage 5)
EMBEDDING_MODEL=
